{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@clarity/shared": ["packages/shared/src"],
      "@clarity/shared/*": ["packages/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "**/node_modules", "dist", "**/dist"]
}
