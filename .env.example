# =============================================================
# PROJECT CLARITY — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================

# ----- MOQ Relay -----
MOQ_RELAY_URL=https://localhost:4443
MOQ_TLS_CERT_PATH=./certs/cert.pem
MOQ_TLS_KEY_PATH=./certs/key.pem
# Content track published by moq-pub
MOQ_CONTENT_NAMESPACE=sling/live
MOQ_CONTENT_TRACK=content

# ----- x402 Payment -----
# Your wallet address that receives ad payments
SELLER_WALLET_ADDRESS=0x
# Free testnet facilitator — no API key required
X402_FACILITATOR_URL=https://x402.org/facilitator
AD_PRICE_USDC=0.0001

# ----- Oracle Signing (Backend) -----
# Generate a fresh dev-only wallet: cast wallet new
# NEVER use a real-funds wallet here
ORACLE_PRIVATE_KEY=0x

# ----- Blockchain -----
# Free public RPC (no key needed for dev):
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Or Alchemy (more reliable): https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
BASESCAN_API_KEY=
CHAIN_ID=84532

# USDC on Base Sepolia (official Circle deployment)
USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ----- Contracts (populated after forge deploy) -----
CMXS_CONTRACT_ADDRESS=
ORACLE_CONTRACT_ADDRESS=
NODE_REGISTRY_ADDRESS=

# ----- Database -----
# Create free project at supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Demo Config -----
# Set to "true" to use a private key wallet (no passkey prompts)
DEMO_MODE=false
# Only used when DEMO_MODE=true — dev/demo wallet private key
DEMO_WALLET_PRIVATE_KEY=0x

# ----- Caton C3 (Phase 1 — leave blank for Phase 0) -----
C3_API_KEY=
NETSCOPE_API_KEY=
C3_RELAY_ENDPOINT=

# ----- API Server -----
API_PORT=3001
API_HOST=0.0.0.0

# ----- AntiGravity Additions -----
TREASURY_ADDRESS=0x
ADBURN_CONTRACT_ADDRESS=
AUCTION_CONTRACT_ADDRESS=
PLATFORM_FEE_BPS=1500

# Node wallets (for multi-node demo)
NODE1_WALLET_PK=0x
NODE2_WALLET_PK=0x
NODE3_WALLET_PK=0x
NODE1_WALLET_ADDRESS=0x
NODE2_WALLET_ADDRESS=0x
NODE3_WALLET_ADDRESS=0x

# Advertiser wallets
ADV1_WALLET_PK=0x
ADV2_WALLET_PK=0x
ADV1_WALLET_ADDRESS=0x
ADV2_WALLET_ADDRESS=0x

# Viewer wallet
VIEWER_WALLET_PK=0x

# Database (for local docker postgres)
DATABASE_URL=postgresql://clarity:clarity@localhost:5432/echoads
ADMIN_TOKEN=dev-admin-token
