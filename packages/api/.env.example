# ── Chain ─────────────────────────────────────────────────────────────────────
# "base-sepolia" for testnet, "base-mainnet" for production
CHAIN=base-sepolia

# ── RPC Endpoints (Alchemy) ───────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Oracle Signer Key ─────────────────────────────────────────────────────────
# This key signs PoD receipts submitted to DeliveryOracleV2.
# MUST be added as an authorized signer: oracle.addAuthorizedSigner(signerAddress)
# NEVER commit a funded key here. Use AWS Secrets Manager in production.
ORACLE_PRIVATE_KEY=0xYOUR_ORACLE_SIGNER_PRIVATE_KEY

# ── V2 Contract Addresses (set after DeployV2.s.sol) ─────────────────────────
DELIVERY_ORACLE_V2_ADDRESS_SEPOLIA=0x
DELIVERY_ORACLE_V2_ADDRESS_MAINNET=0x
CMXS_TOKEN_ADDRESS=0x
NODE_STAKING_ADDRESS=0x
AD_BURN_V2_ADDRESS=0x
TREASURY_ADDRESS=0x
VE_TOKEN_ADDRESS=0x

# ── Legacy V1 Oracle (kept for Phase 0 fallback) ──────────────────────────────
ORACLE_CONTRACT_ADDRESS=0x
CMXS_CONTRACT_ADDRESS=0x
NODE_WALLET_ADDRESS=0x

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Get from: https://upstash.com/  (free tier: 10K req/day)
# For EC2 production use ElastiCache and set REDIS_URL instead.
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/echoads

# ── API Config ────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
ADMIN_TOKEN=change-me-in-production
DASHBOARD_URL=http://localhost:3000

# ── Gnosis Safe (Multisig) ────────────────────────────────────────────────────
# The 3/5 multisig address that holds DEFAULT_ADMIN_ROLE on all contracts
ADMIN_MULTISIG=0x

# ── Deployment (forge script) ─────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_KEY
ORACLE_SIGNER_ADDRESS=0xDERIVED_FROM_ORACLE_PRIVATE_KEY
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASESCAN_API_KEY=YOUR_BASESCAN_KEY
TGE_TIMESTAMP=1700000000

# ── Hummingbot (Phase 3B) ─────────────────────────────────────────────────────
COINBASE_API_KEY=
COINBASE_API_SECRET=
