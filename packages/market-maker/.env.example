# ── Hummingbot Market Maker ─────────────────────────────────────────────────
# Copy this to .env and fill in your values.

# Coinbase Advanced Trade API (create at: https://portal.cdp.coinbase.com/)
COINBASE_API_KEY=organizations/YOUR_ORG/apiKeys/YOUR_KEY
COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\nYOUR_KEY\n-----END EC PRIVATE KEY-----

# Config password for Hummingbot encrypted keys
HUMMINGBOT_CONFIG_PASSWORD=change-me

# Grafana dashboard password
GRAFANA_ADMIN_PASSWORD=change-me

# Uniswap v3 TWAP price endpoint (deployed with LiquidityManager)
# Returns: {"price": "1.23"} — fetched from the on-chain pool TWAP
PRICE_SOURCE_URL=https://api.echoads.tv/api/price/cmxs

# PagerDuty integration (kill-switch alerts)
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
