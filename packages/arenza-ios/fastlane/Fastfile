# fastlane/Fastfile — Arenza iOS CI/CD
# ─────────────────────────────────────────────────────────────────────────────
# Lanes:
#   fastlane test              → Compile + run unit tests on Simulator
#   fastlane beta              → Build + sign + upload to TestFlight
#   fastlane setup_signing     → (run ONCE locally) bootstrap match certificates
# ─────────────────────────────────────────────────────────────────────────────

default_platform(:ios)

SCHEME      = "Arenza"
PROJECT     = "Arenza.xcodeproj"
BUNDLE_ID   = "com.cmxs.arenza"
SIMULATOR   = "platform=iOS Simulator,name=iPhone 16"

platform :ios do

  # ── Test: compile + unit test on Simulator ─────────────────────────────────

  lane :test do
    UI.header("🧪 Running Arenza Tests on iOS Simulator")
    sh("xcodegen generate --spec ../project.yml")

    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [SIMULATOR],
      configuration: "Debug",
      code_coverage: true,
      result_bundle: true,
      output_directory: "./test-results",
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )

    UI.success("✅ All tests passed!")
  end

  # ── Beta: build signed Release IPA + upload to TestFlight ─────────────────

  lane :beta do
    UI.header("🚀 Building Arenza for TestFlight")
    sh("xcodegen generate --spec ../project.yml")

    # 1. Bump build number using current CI run number (or date-based)
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(build_number: build_number, xcodeproj: PROJECT)
    UI.message("Build number: #{build_number}")

    # Strip team ID once here — used by both xcargs and export_options.
    # The APPLE_TEAM_ID secret may have a trailing newline; .strip eliminates it everywhere.
    team_id = (ENV["APPLE_TEAM_ID"] || "5R8WY2Q734").to_s.strip
    UI.message("Team ID: #{team_id}")

    # 2. Install App Store certificates + provisioning profiles via match
    keychain_pass = ENV["MATCH_PASSWORD"] || ""
    keychain_name = "fastlane_tmp_keychain"

    if ENV["CI"]
      # Create and configure the CI keychain (default password is "")
      setup_ci(force: true)

      keychain_db = "#{ENV['HOME']}/Library/Keychains/#{keychain_name}-db"

      # CRITICAL: Prevent keychain auto-lock (default is 5 min!)
      sh("security set-keychain-settings -t 7200 -u '#{keychain_db}'")

      # Set as the default keychain so xcodebuild/codesign find it
      sh("security default-keychain -s '#{keychain_db}'")

      UI.message("Keychain configured: #{keychain_db}")
    end

    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: false,
      git_url: "https://github.com/taocodao/ios-certificates.git",
      git_basic_authorization: Base64.strict_encode64(ENV["MATCH_GIT_BASIC_AUTH"] || ""),
      api_key_path: "./fastlane/AuthKey.json",
      keychain_name: keychain_name,
      keychain_password: "" # setup_ci uses empty password for the keychain itself
    )

    if ENV["CI"]
      keychain_db = "#{ENV['HOME']}/Library/Keychains/#{keychain_name}-db"

      # Grant codesign access to the imported certificate's private key
      # CRITICAL: password is "" for the setup_ci keychain
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k \"\" '#{keychain_db}'")

      # Verify the signing identity is available
      sh("security find-identity -v -p codesigning '#{keychain_db}'")
    end

    # Read the provisioning profile name that match just installed.
    # match sets sigh_* env vars after a successful install — use them to avoid
    # hardcoding and to eliminate any naming mismatch with the portal.
    profile_name = ENV.fetch("sigh_#{BUNDLE_ID}_appstore_profile-name", "match AppStore #{BUNDLE_ID}")
    UI.message("Using provisioning profile: #{profile_name}")

    # 3. Archive
    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Arenza",
      clean: false,   # Skip clean to use incremental build — saves 40+ min on CI
      derived_data_path: "./.derived-data",  # Cacheable path for incremental builds
      include_symbols: false,  # Disable dSYM generation — dsymutil hangs for 30-60 min on CI!
      include_bitcode: false,
      skip_package_pkg: false,
      sdk: "iphoneos",   # Use bundled device SDK directly — avoids generic/platform=iOS runtime check
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          BUNDLE_ID => profile_name
        }
      },
      xcargs: [
        "SWIFT_STRICT_CONCURRENCY=targeted",
        "MARKETING_VERSION=0.1.0",
        "IPHONEOS_DEPLOYMENT_TARGET=18.0",
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGNING_REQUIRED=YES",
        "DEBUG_INFORMATION_FORMAT=dwarf"
      ].join(" "),
      skip_profile_detection: true,
      xcodebuild_formatter: ""
    )

    # 4. Upload to TestFlight
    pilot(
      apple_id: ENV["ASC_APP_ID"] || "6777539402",
      ipa: "./build/Arenza.ipa",
      api_key_path: "./fastlane/AuthKey.json",  # App Store Connect API key
      skip_waiting_for_build_processing: true,   # Don't block CI — upload and continue
      distribute_external: false,                 # Internal testers only for now
      notify_external_testers: false,
      changelog: "Build #{build_number} — Auto-deployed from GitHub Actions"
    )

    UI.success("✅ Arenza #{build_number} uploaded to TestFlight!")

    # 5. Notification summary for GitHub Actions
    if ENV["GITHUB_STEP_SUMMARY"]
      File.open(ENV["GITHUB_STEP_SUMMARY"], "a") do |f|
        f.puts "## ✅ TestFlight Upload Complete"
        f.puts "| | |"
        f.puts "|---|---|"
        f.puts "| Build | #{build_number} |"
        f.puts "| Scheme | #{SCHEME} |"
        f.puts "| Distribution | TestFlight (Internal) |"
        f.puts "| Check | [App Store Connect](https://appstoreconnect.apple.com) |"
      end
    end
  end

  # ── Setup Signing: run ONCE locally with your Apple credentials ────────────
  # This generates certs and uploads them encrypted to your private certs repo.
  # You NEVER need to run this on CI.

  lane :setup_signing do
    UI.header("🔐 Bootstrap Code Signing via Fastlane Match")
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      force_for_new_devices: true,
      readonly: false
    )
    UI.success("✅ Certificates generated and stored in your certs repo!")
  end

  # ── Error handler ──────────────────────────────────────────────────────────

  error do |lane, exception|
    UI.error("Lane '#{lane}' failed: #{exception.message}")
    # In production, send a Slack/Teams notification here
  end

end
