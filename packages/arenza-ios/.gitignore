*.xcodeproj/
!*.xcodeproj/project.xcworkspace/

# Derived data
xcuserdata/
DerivedData/
.build/

# Archives
*.xcarchive

## Fastlane
# Build outputs
build/
fastlane/AuthKey.json          # NEVER commit API keys
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

## Ruby
.bundle/
vendor/bundle/
Gemfile.lock                   # Commit this! It locks gem versions for reproducibility

## Test results
TestResults.xcresult/
*.xcresult/

## macOS
.DS_Store

